// Sorts a[lo..hi], smallest first.
// Start with quickSort(a, 0, length(a) - 1).

function quickSort(a, lo, hi)
  if lo >= hi then return
  p = partition(a, lo, hi)
  quickSort(a, lo, p - 1)
  quickSort(a, p + 1, hi)
end function

// Lomuto: the pivot is the last item.
function partition(a, lo, hi)
  if randomPivot then swap a[random(lo, hi)] and a[hi] // @line random-pivot
  pivot = a[hi] // @line pivot
  i = lo // @line pivot
  for j from lo to hi - 1
    if a[j] <= pivot then // @line compare
      swap a[i] and a[j] // @line swap
      i = i + 1
    end if
  end for
  swap a[i] and a[hi] // @line place
  return i
end function
