// items holds the values, bottom first.
// top is the index of the top item,
// or -1 when the stack is empty.

function push(value)
  if top is capacity - 1 then // @line check-full
    error "Stack overflow" // @line overflow
  end if
  top = top + 1 // @line push
  items[top] = value // @line push
end function

function pop()
  if top is -1 then // @line check-empty
    error "Stack underflow" // @line underflow
  end if
  value = items[top] // @line read-top
  top = top - 1 // @line pop
  return value // @line pop
end function

function peek()
  if top is -1 then
    error "Stack is empty" // @line peek-empty
  end if
  return items[top] // @line peek
end function

function clear()
  top = -1 // @line clear
end function

function isBalanced(text)
  stack = an empty stack
  for each ch in text do // @line scan
    if ch is an opening bracket then
      push(ch) // @line push-open
    else if ch is a closing bracket then
      if stack is empty then
        return false // @line close-empty
      end if
      if peek() is not the partner of ch then // @line close-match
        return false // @line mismatch
      end if
      pop() // @line pop-open
    end if
  end for
  if stack is not empty then
    return false // @line unclosed
  end if
  return true // @line balanced
end function
