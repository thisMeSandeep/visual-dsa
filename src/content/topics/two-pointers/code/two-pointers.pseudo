// Two indices moving through one array.

function reverse(a)
  left = 0, right = length(a) - 1 // @line reverse-start
  while left < right
    swap a[left] and a[right] // @line reverse-swap
    left = left + 1, right = right - 1 // @line reverse-swap
  end while
  return a // @line reverse-done
end function

// a is sorted, smallest first.
function pairSum(a, target)
  left = 0, right = length(a) - 1 // @line pair-start
  while left < right
    sum = a[left] + a[right]
    if sum == target then return (left, right) // @line pair-found
    if sum < target then
      left = left + 1 // @line pair-left
    else
      right = right - 1 // @line pair-right
    end if
  end while
  return none // @line pair-none
end function

// a is sorted. Keeps one of each value at the front.
function removeDuplicates(a)
  write = 1 // @line dedupe-start
  for read from 1 to length(a) - 1
    if a[read] == a[write - 1] then continue // @line dedupe-skip
    a[write] = a[read] // @line dedupe-keep
    write = write + 1 // @line dedupe-keep
  end for
  return write // @line dedupe-done
end function
