// Project settings for the Zed editor.
// Prettier formats on save using the project's .prettierrc.json.
// ESLint diagnostics appear automatically through Zed's built-in ESLint language server.
{
  "format_on_save": "on",
  "tab_size": 2,
  "languages": {
    "TypeScript": { "formatter": "prettier" },
    "TSX": { "formatter": "prettier" },
    "JavaScript": { "formatter": "prettier" },
    "JSON": { "formatter": "prettier" },
    "CSS": { "formatter": "prettier" }
  },
  "file_scan_exclusions": ["**/.git", "**/node_modules", "**/.expo", "**/dist"]
}
